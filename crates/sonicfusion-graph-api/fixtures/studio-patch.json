{
  "version": 1,
  "nodes": [
    { "id": "osc_a", "kind": "sine", "params": { "frequency_hz": 220.0 } },
    { "id": "osc_b", "kind": "square", "params": { "frequency_hz": 110.0, "pulse_width": 0.3 } },
    { "id": "lfo", "kind": "sine", "params": { "frequency_hz": 0.5 } },
    { "id": "mix", "kind": "mix", "params": { "weights": [0.6, 0.4] } },
    { "id": "lpf", "kind": "low_pass", "params": { "cutoff_hz": 1200.0 } },
    { "id": "gain", "kind": "gain", "params": { "factor": 0.08 } },
    { "id": "out", "kind": "output", "params": {} }
  ],
  "wires": [
    { "from": "osc_a", "to": { "node": "mix", "port": "in.0" } },
    { "from": "osc_b", "to": { "node": "mix", "port": "in.1" } },
    { "from": "mix", "to": { "node": "lpf", "port": "in" } },
    { "from": "lfo", "to": { "node": "lpf", "port": "cutoff" } },
    { "from": "lpf", "to": { "node": "gain", "port": "in" } },
    { "from": "gain", "to": { "node": "out", "port": "in" } }
  ]
}
